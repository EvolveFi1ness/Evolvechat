# EvolveChat — environment variables
# These are NOT used by the static site itself (GitHub Pages has no backend).
# They are consumed by the monitoring worker (scripts/monitor/) which runs in
# GitHub Actions — set them as repository secrets (Settings → Secrets → Actions).

# Base64-encoded Firebase service account JSON.
# Generate: firebase-adminsdk JSON → certutil -encode svc.json svc.b64
# Grants Firestore read/write for the monitoring worker only.
FIREBASE_SERVICE_ACCOUNT_B64=

# Telegram bot alerts + commands (optional).
# Create a bot via @BotFather, then message it once and get your chat id:
#   curl "https://api.telegram.org/bot<TOKEN>/getUpdates"
TELEGRAM_BOT_TOKEN=
# Comma-separated chat IDs allowed to receive alerts and run /commands:
TELEGRAM_CHAT_ID=
