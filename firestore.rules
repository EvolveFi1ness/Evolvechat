rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {

  // ── Helpers ──────────────────────────────────────────────
  function isSignedIn() {
   return request.auth != null;
  }

  function isSelf(uid) {
   return isSignedIn() && request.auth.uid == uid;
  }

  // Coach if: (1) coaches/{auth.uid} exists, or (2) token email matches.
  function isCoach() {
   return isSignedIn() && (
    exists(/databases/$(database)/documents/coaches/$(request.auth.uid))
    || request.auth.token.email == 'coach@evolvechat-21d6f.app'
   );
  }

  // ChatId = "<uidA>_<uidB>" (sorted). A participant is anyone whose uid
  // appears in the split — works even before the chat doc exists.
  function isParticipant(chatId) {
   return isSignedIn() && request.auth.uid in chatId.split('_');
  }

  // ── Members ──────────────────────────────────────────────
  // Client: own doc + subtree (log subcollections only).
  // Coach: full read + write (plans, approval, nutrition, archive).
  match /members/{userId} {
   allow read: if isSelf(userId) || isCoach();
   allow create: if isCoach()
    || (isSelf(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.approvalStatus == 'pending');
   allow update: if isCoach()
    || (isSelf(userId) && request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['uid','firstName','lastName','email','goal','plan',
                  'dateOfBirth','age','heightCm','weightKg','weightDisplay','sex',
                  'currentWeightKg','currentWeightDisplay','currentWeightDate',
                  'allergies','medications','medicalConditions','emergencyContact',
                  'profileComplete','profileCompletedAt','memberSince',
                  'attendanceCount','personalRecords',
                  'isOnline','lastSeenAt','lastLoginAt']));
   allow delete: if isCoach();

   // Subcollections — coach has full access; client may write only log
   // collections. All other nested paths are deny-by-default.
   match /{sub}/{doc} {
    allow read: if isSelf(userId) || isCoach();
    // nutritionPlans is deliberately excluded — clients read only.
    allow write: if isCoach()
     || (isSelf(userId) && sub in ['workoutLogs','mealLogs','checkIns',
                                    'progressPhotos','goals','customFoods']);
   }
  }

  // ── Coaches ──────────────────────────────────────────────
  // Coach has full access to all coach docs and subcollections.
  match /coaches/{coachId} {
   allow read, write: if isCoach();
   match /{document=**} {
    allow read, write: if isCoach();
   }
  }

  // ── Chats ────────────────────────────────────────────────
  // Only participants (client + coach) access a chat.
  // Clients: read + send (senderId must be own UID). Coach: full control.
  match /chats/{chatId} {
   allow read: if isCoach() || isParticipant(chatId);
   allow create: if isCoach()
    || (isParticipant(chatId)
        && request.auth.uid in request.resource.data.participants);
   allow update: if isCoach()
    || (isParticipant(chatId)
        && request.auth.uid in resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['participants','lastMessage','lastAt','lastSenderRole',
                      'clientLastReadAt']));
   allow delete: if isCoach();

   match /messages/{msgId} {
    allow read: if isCoach() || isParticipant(chatId);
    allow create: if (isCoach() || isParticipant(chatId))
     && (request.resource.data.senderId == request.auth.uid
         || (isCoach() && request.resource.data.senderId == 'evolve_coach_001'));
    allow update, delete: if isCoach();
   }
  }

  // ── FCM tokens ───────────────────────────────────────────
  match /fcmTokens/{userId} {
   allow read: if isSelf(userId) || isCoach();
   allow write: if isSelf(userId);
  }

  // ── Food database ────────────────────────────────────────
  match /foodDatabase/{foodId} {
   allow read: if isSignedIn();
   allow write: if isCoach();
  }

  // ── Photo requests ───────────────────────────────────────
  // Coach creates; client may only fulfill their own (or an 'all' broadcast).
  match /photoRequests/{reqId} {
   allow read: if isSignedIn()
    && (resource.data.clientId == request.auth.uid
        || resource.data.clientId == 'all'
        || resource.data.assignTo == 'all');
   allow create: if isCoach();
   allow update: if isCoach()
    || ((resource.data.clientId == request.auth.uid
         || resource.data.assignTo == 'all')
        && request.resource.data.fulfilled == true
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['fulfilled','url','submittedNote','fulfilledAt','fulfilledBy']));
   allow delete: if isCoach();
  }

  // ── Presence ─────────────────────────────────────────────
  match /presence/{userId} {
   allow read: if isSelf(userId) || isCoach() || userId == 'evolve_coach_001';
   allow write: if isSelf(userId)
    || (isCoach() && userId == 'evolve_coach_001');
  }

  // ── Login history (append-only) ──────────────────────────
  match /logins/{loginId} {
   allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
   allow read: if isCoach();
  }

  // ── Monitoring collections (written by Actions worker via Admin SDK) ──
  match /monitors/{monitorId} {
    allow read: if true;
    allow write: if false;
  }
  match /monitorChecks/{checkId} {
    allow read: if true;
    allow write: if false;
  }
  match /incidents/{incidentId} {
    allow read: if true;
    allow write: if false;
  }
  match /monitorNotifications/{notifId} {
    allow read: if true;
    allow write: if false;
  }
  match /monitorConfig/{docId} {
    allow read: if true;
    allow write: if false;
  }

  // ── Coach notifications ─────────────────────────────────
  match /coachNotifications/{notifId} {
    allow read: if isCoach();
    allow write: if isCoach();
  }

  // ── Collection-group rules (required for collectionGroup() queries) ──
  // Firestore does NOT resolve collectionGroup queries through nested
  // match blocks — these top-level matches are the only rules evaluated.
  match /workoutLogs/{logId} {
    allow read: if isCoach();
    allow write: if isCoach();
  }
  match /progressPhotos/{logId} {
    allow read: if isCoach();
    allow write: if isCoach();
  }
 }
}
